# StockSmart Environment Configuration Template
# Copy this file to .env and configure your local settings

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stocksmart
DB_USERNAME=root
DB_PASSWORD=

# JWT Secret (minimum 256 bits)
JWT_SECRET=StockSmartDefaultSecretKeyForDevelopmentOnlyChangeInProduction2024!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:4200
